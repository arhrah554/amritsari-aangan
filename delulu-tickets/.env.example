# Copy this file to `.env` and fill it in. Never commit `.env` (it holds your secrets).
# Locally you can leave EVERYTHING empty: the site runs in demo mode with a built-in database.

# ── Site ────────────────────────────────────────────────────────────────────
# Uncomment on the live server. Production refuses to start without the settings marked (required).
# NODE_ENV=production
PUBLIC_URL=                 # (required) e.g. https://tickets.deluluproduction.in
ADMIN_PASSWORD=             # (required) 10+ characters, for /admin
SCANNER_PIN=                # (required) 6+ digits, give it to gate staff for /scan
PORT=3000

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Start with rzp_test_ keys, switch to rzp_live_ after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string; paste the same one when you add the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# Empty = built-in database saved in ./data (fine for your laptop or a server with a disk).
# For the live site use hosted Postgres, e.g. Supabase → Connect → Session pooler URI.
DATABASE_URL=

# ── Email (optional) ────────────────────────────────────────────────────────
# Without this, buyers still get their passes on screen. Gmail needs an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DELULU PRODUCTION <you@gmail.com>"
